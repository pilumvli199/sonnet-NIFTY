# === UPSTOX 1-YEAR ANALYTICS TOKEN (For NIFTY 50) ===

UPSTOX_ANALYTICS_TOKEN=your_1_year_upstox_token_here



# === DUAL AI ROUTER (Primary: Gemini Free Tier | Backup: Claude) ===

GEMINI_API_KEYS=your_gemini_free_api_key_1,your_gemini_free_api_key_2

GEMINI_MODEL=gemini-2.5-flash



# Backup Claude API Key (Used automatically if Gemini server is busy/429/503)

ANTHROPIC_API_KEY=your_claude_backup_api_key_here

CLAUDE_BACKUP_MODEL=claude-haiku-4-5-20251001



# === TELEGRAM BOT CONFIG ===

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

TELEGRAM_CHAT_ID=your_default_telegram_chat_id_here

NIFTY_TELEGRAM_CHAT_ID=

BTC_TELEGRAM_CHAT_ID=

GOLD_TELEGRAM_CHAT_ID=



# === ENABLE / DISABLE INDIVIDUAL BOTS ===

ENABLE_NIFTY=true

ENABLE_BTC=true

ENABLE_GOLD=true



# === NIFTY 50 MEMORY & POLLING SETTINGS ===

NIFTY_PRICE_RANGE_PTS=50

NIFTY_ZONE_PROXIMITY_PTS=50



# === OPTIONAL 30MB REDIS (Leave blank to use built-in <5MB Bounded RAM) ===

REDIS_URL=

PORT=8000

